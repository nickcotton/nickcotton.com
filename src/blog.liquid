---
layout: 'layouts/page.liquid'
title: 'blog'
meta:
  desc:
    'The blog part.'
---

<div class="grid grid-cols-4 gap-16">
  <div class="col-span-3">
    <h2 class="font-serif text-2xl md:text-4xl font-bold leading-none mb-5">Latest posts</h2>
    {% for post in collections.posts reversed %}
      <div class="flex flex-col sm:flex-row gap-x-6 gap-y-2 items-baseline justify-between border-b border-slate-400 dark:border-slate-700 py-4 last:border-b-0">
        <h2 class="dark:text-white text-xl sm:text-2xl leading-none"><a href="{{ post.url }}" class="block">{{ post.data.title }}</a></h2>
        <p class="shrink-0 text-slate-400 sm:text-slate-500 dark:text-slate-300 leading-none text-sm sm:text-base">{{ post.page.date | postDate }}</p>
      </div>
    {% endfor %}
  </div>
  <aside>
    <h2 class="font-serif text-xl md:text-2xl font-bold leading-none mb-5 mt-2">Blogroll</h2>
    <ul class="list-none flex flex-col gap-2">
      {% for blog in blogroll %}
        <li>
          <a href="{{ blog.url }}" class="block text-slate-400 dark:text-slate-300 hover:text-slate-500 dark:hover:text-slate-400">{{ blog.name }}</a>
        </li>
      {% endfor %}
    </ul>
  </aside>
</div>
