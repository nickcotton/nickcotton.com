{% if social.image %}
  {% assign socialImage = site.data.url | append: '/images/' | append: social.image %}
{% else %}
  {% assign socialImage = site.data.url | append: '/images/social-share.png' %}
{% endif %}

<meta name="twitter:card" content="summary_large_image" />
<meta property="og:image" content="{{ socialImage }}" />
<meta name="twitter:image" content="{{ socialImage }}" />
<meta property="og:image:alt" content="Page image for {{ site.data.name }}" />
<meta name="twitter:image:alt" content="Page image for {{ site.data.name }}" />
