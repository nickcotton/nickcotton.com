{
  "engines": {
    "node": "20.11.1",
    "npm": "10.2.4"
  },
  "author": {
    "name": "Nick Cotton",
    "email": "nick.c.cotton@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "lint-staged": {
    "*.html": "prettier --write",
    "*.css": "stylelint --cache --fix",
    "*.js": "eslint --cache --fix"
  },
  "type": "module",
  "scripts": {
    "clean": "rimraf _site",
    "prepare": "husky",
    "preview": "npx vite preview",
    "predev": "run-s clean",
    "dev": "cross-env NODE_ENV=development run-p dev:*",
    "dev:eleventy": "npx @11ty/eleventy --serve --incremental --port=8081",
    "prebuild": "run-s clean",
    "build": "cross-env NODE_ENV=production run-s build:*",
    "build:eleventy": "npx @11ty/eleventy",
    "lint": "run-s lint:*",
    "lint:html": "npx prettier --check \"src/**/*.liquid\"",
    "lint:stylelint": "npx stylelint \"src/**/*.css\"",
    "lint:eslint": "npx eslint --ext .js src/",
    "format": "run-s format:*",
    "format:html": "npx prettier --write \"src/**/*.liquid\"",
    "format:stylelint": "npx stylelint \"src/**/*.css\" --fix",
    "format:eslint": "npx eslint --ext .js src/ --fix",
    "validate": "run-s build lint",
    "setup": "npm install && npm run validate"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.0.0",
    "@11ty/eleventy-img": "^6.0.1",
    "@11ty/eleventy-plugin-rss": "^2.0.3",
    "@11ty/eleventy-plugin-vite": "^6.0.0",
    "@eslint/compat": "^1.2.6",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@eslint/json": "^0.6.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.13.0",
    "autoprefixer": "^10.4.20",
    "browserslist": "^4.24.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-compat": "^6.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^15.14.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "lodash.escape": "^4.0.1",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "nanoid": "^5.0.9",
    "netlify-plugin-cache": "^1.0.3",
    "node-fetch": "^3.3.2",
    "npm-run-all": "^4.1.5",
    "outdent": "^0.8.0",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rimraf": "^6.0.1",
    "rss-parser": "^3.13.0",
    "shiki": "^1.29.2",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@alpinejs/persist": "^3.14.9",
    "alpinejs": "^3.14.9",
    "sharp": "^0.33.5"
  }
}
