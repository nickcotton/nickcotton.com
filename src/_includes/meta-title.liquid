{% assign metaTitle = site.meta.title | default: '' %}
{% if metaTitle == '' %}
  {% if site.name == page.title %}
    {% assign metaTitle = page.title %}
  {% else %}
    {% assign metaTitle = page.title | append: ' :: ' | append: site.name %}
  {% endif %}
{% endif %}
<title>{{ metaTitle }}</title>
