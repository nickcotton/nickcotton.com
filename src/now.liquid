---
layout: 'layouts/page.liquid'
title: 'now'
meta:
  desc: 'What I’ve been up to. A now page.'
---

<div class="mx-auto prose dark:prose-invert mb-32">
  {% renderFile "./src/_includes/now-content.md" %}
</div>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-8">
  <header class="flex flex-wrap gap-x-4 gap-y-2 items-baseline justify-between mb-5">
    <h2 class="font-serif text-2xl md:text-4xl font-bold leading-none">What I've been watching</h2>
    <p class="text-sm md:text-base italic"><a href="https://letterboxd.com/nickcotton/" class="underline">On Letterboxd</a></p>
  </header>
  <ul class="list-none p-0 m-0 grid grid-cols-3 sm:grid-cols-6 lg:grid-cols-8 gap-4">
    {% for film in letterboxd limit:24 %}
      <li class="animate-rise-in" style="animation-fill-mode: backwards; --index: {{ forloop.index }}">
        <a href="{{ film.link }}" class="block border border-slate-300 dark:border-slate-500 rounded-sm overflow-hidden">
          <img src="{{ film.posterImageSrc }}" alt="{{ film.title }}" class="w-full h-auto">
        </a>
      </li>
    {% endfor %}
  </ul>
</div>
