---
layout: 'layouts/base.liquid'
title: 'Home'
meta:
  desc:
    'My online home. Part blog, part portfolio, part playground.'
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-8" x-data="{open: false, toggle(){this.open = !this.open;}}">
  <h1 class="font-serif text-7xl sm:text-8xl md:text-9xl font-bold leading-none text-stone-100 mb-5">
    <div class="flex">
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.1s;">N</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.2s;">i</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.3s;">c</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.4s;">k</span></span>
    </div>
    <div class="flex">
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.1s;">C</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.2s;">o</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.3s;">t</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.4s;">t</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.5s;">o</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.6s;">n</span></span>
    </div>
  </h1>
  <p class="font-sans text-stone-100 text-xl mb-3">Front-end developer.</p>
  <p class="font-sans text-stone-100 text-xl mb-3">Obsessed with performance, code quality, and accessibility.</p>
  <p class="font-sans text-stone-100 text-xl mb-3"><a href="#" class="underline" @click="toggle">Get in touch</a>.</p>

  <div x-show="open" x-data="contactForm()" x-cloak x-transition>
    <form
      name="contact"
      method="POST"
      class="grid gap-8 grid-cols-2 max-w-xl"
      netlify
      @submit.prevent="submitForm">
      <p class="font-sans text-xl">
        <label for="name" class="block text-stone-100 mb-2">Your name</label>
        <input id="name" name="name" type="text" class="w-full p-2 mb-2 rounded-md bg-slate-800 focus:bg-stone-100 text-stone-100 focus:text-slate-900" />
      </p>
      <p class="font-sans text-xl">
        <label for="email" class="block text-stone-100 mb-2">Your email</label>
        <input id="email" name="email" type="email" class="w-full p-2 mb-2 rounded-md bg-slate-800 focus:bg-stone-100 text-stone-100 focus:text-slate-900" />
      </p>
      <p class="font-sans text-xl col-span-2">
        <label for="name" class="block text-stone-100 mb-2">Message</label>
        <textarea name="message" rows="6" class="block w-full p-2 mb-2 rounded-md bg-slate-800 focus:bg-stone-100 text-stone-100 focus:text-slate-900"></textarea>
      </p>
      <p class="font-sans text-xl col-span-2 sm:col-span-1">
        <label for="movie" class="block text-stone-100 mb-2">Your favourite movie</label>
        <input id="movie" name="movie" class="w-full p-2 mb-2 rounded-md bg-slate-800 focus:bg-stone-100 text-stone-100 focus:text-slate-900" />
      </p>
      <p class="col-span-2">
        <button type="submit" class="bg-blue-600 text-white font-montserrat py-2 px-8 font-medium rounded-md hover:bg-blue-500 transition-all duration-300" style="box-shadow: 0 15px 30px -5px rgba(37, 99, 235, 0.6);">Send</button>
      </p>
    </form>
  </div>
</div>

<script>
  function ContactForm() {
    return {
      formData: {
        name: "",
        email: "",
        message: "",
      },
      submitForm() {
        console.log(JSON.stringify(this.formData));
      },
    };
  }
</script>
