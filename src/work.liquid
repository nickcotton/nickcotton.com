---
layout: 'layouts/page.liquid'
title: 'Work'
meta:
  desc:
    'All work and no play'
---

{% for project in projects %}
  <section class="mb-16">
    <h2 class="font-serif text-2xl md:text-4xl font-bold leading-none mb-5">{{ project.name }}</h2>
    <ul class="dark:bg-slate-900 flex gap-6 pb-4 snap-mandatory snap-x scroll-pl-4 sm:scroll-pl-6 lg:scroll-pl-8 xl:scroll-pl-0 overflow-x-auto overscroll-x-contain -mx-4 sm:-mx-6 lg:-mx-8 xl:-mx-0">
      {% for image in project.images %}
        {% assign custom_classes = '' %}
        {% if forloop.first %}
          {% assign custom_classes = 'pl-4 sm:pl-6 lg:pl-8 xl:pl-0' %}
        {% elsif forloop.last %}
          {% assign custom_classes = 'pr-4 sm:pr-6 lg:pr-8 xl:pr-0' %}
        {% endif %}
        <li class="shrink-0 snap-start {{ custom_classes }}">
          <figure>
            <img src="/images/projects/{{ project.id }}/{{ forloop.index }}.png" alt="{{ image.alt }}" class="w-[calc(100vw-8rem)] max-w-3xl rounded-md">
            <figcaption class="text-sm text-gray-500 mt-2">{{ image.caption }}</figcaption>
          </figure>
        </li>
      {% endfor %}
    </ul>
  </section>
{% endfor %}
