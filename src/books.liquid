---
title: Books
layout: layouts/page.liquid
permalink: /books/
---

<ul class="space-y-2">
  {% for book in collections.booksByFinish %}
    {% assign rating = book.data.rating | default: 0 %}
    {% if rating > 5 %}{% assign rating = 5 %}{% endif %}
    {% if rating < 0 %}{% assign rating = 0 %}{% endif %}
    <li class="flex items-center gap-x-3">
      <div class="flex-shrink-0 w-20 inline-flex">
        {% for i in (1..rating) %}
          <span class="text-yellow-500">★</span>
        {% endfor %}
      </div>

      <div>
        <a href="{{ book.url }}" class="font-semibold">{{ book.data.title }}</a>
        <span class="text-sm text-gray-600 ml-1">by {{ book.data.author }}</span>
      </div>
    </li>
  {% endfor %}
</ul>
