---
layout: 'layouts/base.liquid'
title: 'Home'
meta:
  desc:
    'My online home. Part blog, part portfolio, part playground.'
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-8" x-data="{open: false, toggle(){this.open = !this.open;}}">
  <h1 class="font-serif text-7xl sm:text-8xl md:text-9xl font-bold leading-none mb-5">
    <div class="flex">
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.1s;">N</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.2s;">i</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.3s;">c</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.4s;">k</span></span>
    </div>
    <div class="flex">
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.1s;">C</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.2s;">o</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.3s;">t</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.4s;">t</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.5s;">o</span></span>
      <span class="letter-wrap"><span class="letter" style="animation-delay: 0.6s;">n</span></span>
    </div>
  </h1>
  <p class="font-sans text-xl mb-3">Front-end developer.</p>
  <p class="font-sans text-xl mb-3">Obsessed with performance, code quality, and accessibility.</p>
  <p class="font-sans text-xl mb-3"><a href="#" class="underline" @click="toggle">Get in touch</a>.</p>

  <div x-show="open" x-data="ContactForm()" x-cloak x-transition>
    <form
      name="contact"
      method="POST"
      class="grid gap-8 grid-cols-2 max-w-xl"
      data-netlify="true"
      @submit.prevent="submitForm">
      <p class="font-sans text-xl">
        <label for="name" class="block mb-2">Your name</label>
        <input x-model="formData.name" id="name" name="name" type="text" class="w-full p-2 mb-2 rounded-md bg-gray-100 dark:bg-slate-800 focus:bg-stone-100 focus:text-slate-900" />
      </p>
      <p class="font-sans text-xl">
        <label for="email" class="block mb-2">Your email</label>
        <input x-model="formData.email" id="email" name="email" type="email" placeholder="test@example.com" class="w-full p-2 mb-2 rounded-md bg-gray-100 dark:bg-slate-800 focus:bg-stone-100 focus:text-slate-900" />
      </p>
      <p class="font-sans text-xl col-span-2">
        <label for="name" class="block mb-2">Message</label>
        <textarea x-model="formData.message" name="message" rows="6" class="block w-full p-2 mb-2 rounded-md bg-gray-100 dark:bg-slate-800 focus:bg-stone-100 focus:text-slate-900"></textarea>
      </p>
      <p class="font-sans text-xl col-span-2 sm:col-span-1">
        <label for="movie" class="block mb-2">Your favourite movie</label>
        <input x-model="formData.favouriteMovie" id="movie" name="movie" class="w-full p-2 mb-2 rounded-md bg-gray-100 dark:bg-slate-800 focus:bg-stone-100 focus:text-slate-900" />
      </p>
      <p class="col-span-2">
        <button type="submit" class="bg-blue-600 text-white py-2 px-8 font-medium rounded-md hover:bg-blue-500 disabled:hover:bg-blue-600 transition-all duration-300 relative"
style="box-shadow: 0 15px 30px -5px rgba(37, 99, 235, 0.6);" :class="{'opacity-50 cursor-not-allowed': !isFormValid}" :disabled="!isFormValid || buttonState !== 'ready'">
          <span :class="{'opacity-0': buttonState !== 'ready'}" class="transition-opacity">Send</span>
          <span x-show="buttonState === 'loading'" x-transition class="absolute inset-0 flex justify-center items-center">
            <svg aria-hidden="true" role="status" class="inline w-4 h-4 text-white animate-spin" viewBox="0 0 100 101" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="#E5E7EB"></path>
            <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentColor"></path>
            </svg>
          </span>
          <span x-show="buttonState === 'success'" x-transition class="absolute inset-0 flex justify-center items-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
          </span>
          <span x-show="buttonState === 'error'" x-transition class="absolute inset-0 flex justify-center items-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
              <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
            </svg>

          </span>
        </button>
      </p>
    </form>
  </div>
</div>

<script>
  const sleep = ms => new Promise(r => setTimeout(r, ms));

  function ContactForm() {
    return {
      formData: {
        name: "",
        email: "",
        message: "",
        favouriteMovie: "",
      },
      buttonState: "ready",
      get isFormValid() {
        return this.formData.name && this.formData.email && this.formData.message && this.formData.favouriteMovie;
      },
      async submitForm() {
        this.buttonState = "loading";
        await sleep(1000);
        fetch(location.href, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(this.formData),
        })
          .then(() => {
            this.buttonState = "success";
            this.formData.name = "";
            this.formData.email = "";
            this.formData.message = "";
          })
          .catch((e) => {
            this.buttonState = "error";
            console.error(e);
          })
          .finally(() => {
            setTimeout(() => {
              this.buttonState = "ready";
            }, 3000);
          })
      },
    };
  }
</script>
