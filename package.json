{
  "engines": {
    "node": "20.9.0",
    "npm": "10.1.0"
  },
  "author": {
    "name": "Nick Cotton",
    "email": "nick.c.cotton@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "lint-staged": {
    "*.html": "prettier --write",
    "*.css": "stylelint --cache --fix",
    "*.js": "eslint --cache --fix"
  },
  "scripts": {
    "clean": "rimraf _site",
    "prepare": "husky",
    "preview": "npx vite preview",
    "predev": "run-s clean",
    "dev": "cross-env NODE_ENV=development run-p dev:*",
    "dev:eleventy": "npx @11ty/eleventy --serve --incremental",
    "prebuild": "run-s clean",
    "build": "cross-env NODE_ENV=production run-s build:*",
    "build:eleventy": "npx @11ty/eleventy",
    "lint": "run-s lint:*",
    "lint:html": "npx prettier --check \"src/**/*.liquid\"",
    "lint:stylelint": "npx stylelint \"src/**/*.css\"",
    "lint:eslint": "npx eslint --ext .js src/",
    "format": "run-s format:*",
    "format:html": "npx prettier --write \"src/**/*.liquid\"",
    "format:stylelint": "npx stylelint \"src/**/*.css\" --fix",
    "format:eslint": "npx eslint --ext .js src/ --fix",
    "validate": "run-s build lint",
    "setup": "npm install && npm run validate"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.2.4",
    "browserslist": "^4.23.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-compat": "^4.0.0",
    "eslint-plugin-import": "^2.23.2",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "markdown-it-task-lists": "^2.1.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "postcss-cli": "^10.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "rimraf": "^5.0.0",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "@11ty/eleventy-plugin-vite": "^4.0.0",
    "@alpinejs/persist": "^3.13.5",
    "alpinejs": "^3.13.5",
    "core-js": "^3.29.1",
    "luxon": "^3.4.4"
  }
}
