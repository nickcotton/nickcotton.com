<footer class="sticky bottom-0">
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ul class="list-unstyled py-4 sm:py-0 grid grid-cols-2 sm:flex sm:h-16 items-center gap-3">
      {% for item in navigation.footer %}
        {% assign current = '' %}
        {% if item.url == page.url %}
          {% assign current = 'aria-current="page"' %}
        {% endif %}
        {% assign separatorClasses = '' %}
        {% unless forloop.first %}
          {% assign separatorClasses = 'sm:before:block sm:before:h-1 sm:before:w-1 sm:before:rounded-full sm:before:bg-slate-400' %}
        {% endunless %}
        <li class="flex items-center gap-3 {{ separatorClasses }}">
          <a
            href="{{ item.url }}"
            class="text-sm md:text-base"
            {{ current }}
          >
            {{ item.text }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</footer>
