---
layout: 'layouts/page.liquid'
title: 'blog'
meta:
  desc:
    'The blog part.'
---

<div class="grid grid-cols-4 gap-16">
  <div class="col-span-3">
    <h2 class="font-serif text-2xl md:text-4xl font-bold leading-none mb-5">Latest posts</h2>
    {% for post in collections.posts reversed %}
      <div class="flex flex-col sm:flex-row gap-x-6 gap-y-2 items-baseline justify-between border-b border-slate-400 dark:border-slate-700 py-4 last:border-b-0">
        <h2 class="dark:text-white text-xl sm:text-2xl leading-none"><a href="{{ post.url }}" class="block">{{ post.data.title }}</a></h2>
        <p class="shrink-0 text-slate-400 sm:text-slate-500 dark:text-slate-300 leading-none text-sm sm:text-base">{{ post.page.date | postDate }}</p>
      </div>
    {% endfor %}
  </div>
  <aside>
    <header class="flex items-center justify-between gap-3 mt-2 mb-5">
      <h2 class="font-serif text-xl md:text-2xl font-bold leading-none">Blogroll</h2>
      <a href="/blogroll.opml.xml" class="flex items-center gap-1 rounded-xl bg-slate-600 px-2 py-1 text-xs" download>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
          <path fill-rule="evenodd" d="M4.5 13a3.5 3.5 0 0 1-1.41-6.705A3.5 3.5 0 0 1 9.72 4.124a2.5 2.5 0 0 1 3.197 3.018A3.001 3.001 0 0 1 12 13H4.5Zm6.28-3.97a.75.75 0 1 0-1.06-1.06l-.97.97V6.25a.75.75 0 0 0-1.5 0v2.69l-.97-.97a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.06 0l2.25-2.25Z" clip-rule="evenodd" />
        </svg>
        OPML
      </a>
    </header>
    <ul class="list-none flex flex-col gap-2">
      {% for blog in blogroll %}
        <li class="flex justify-between gap-3">
          <a href="{{ blog.url }}" class="block text-slate-400 dark:text-slate-300 hover:text-slate-500 dark:hover:text-slate-400">{{ blog.name }}</a>
          <a href="{{ blog.feed }}" class="shrink-0 text-slate-400 dark:text-slate-300 hover:text-slate-500 dark:hover:text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M2 2.75A.75.75 0 0 1 2.75 2C8.963 2 14 7.037 14 13.25a.75.75 0 0 1-1.5 0c0-5.385-4.365-9.75-9.75-9.75A.75.75 0 0 1 2 2.75Zm0 4.5a.75.75 0 0 1 .75-.75 6.75 6.75 0 0 1 6.75 6.75.75.75 0 0 1-1.5 0C8 10.35 5.65 8 2.75 8A.75.75 0 0 1 2 7.25ZM3.5 11a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" clip-rule="evenodd" />
            </svg>
          </a>
        </li>
      {% endfor %}
    </ul>
  </aside>
</div>
