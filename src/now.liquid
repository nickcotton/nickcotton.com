---
layout: 'layouts/page.liquid'
title: 'now'
meta:
  desc: 'What I’ve been up to. A now page.'
---

<div class="mx-auto prose dark:prose-invert mb-32">
  {% renderFile "./src/_includes/now-content.md" %}
</div>

<section class="mx-auto max-w-7xl mb-16">
  <header class="flex flex-wrap gap-x-4 gap-y-2 items-baseline justify-between mb-5">
    <h2 class="font-serif text-2xl md:text-4xl font-bold leading-none">What I've been watching</h2>
    <p class="text-sm md:text-base italic"><a href="https://letterboxd.com/nickcotton/" class="underline">Letterboxd ↗</a></p>
  </header>
  <ul class="list-none p-0 m-0 grid grid-cols-3 sm:grid-cols-6 lg:grid-cols-8 gap-4">
    {% for film in letterboxd limit:24 %}
      <li class="animate-rise-in" style="animation-fill-mode: backwards; --index: {{ forloop.index }}">
        <a href="{{ film.link }}" class="block border border-slate-300 dark:border-slate-500 rounded-sm overflow-hidden">
          <img src="{{ film.posterImageSrc }}" alt="{{ film.title }}" class="w-full h-auto" eleventy:widths="400" width="400" height="600">
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<section class="mx-auto max-w-7xl mb-16">
  <header class="flex flex-wrap gap-x-4 gap-y-2 items-baseline justify-between mb-5">
    <h2 class="font-serif text-2xl md:text-4xl font-bold leading-none">What I've been reading</h2>
    <p class="text-sm md:text-base italic"><a href="https://literal.club/nickcotton/" class="underline">Literal ↗</a></p>
  </header>
  <ul class="list-none p-0 m-0 grid grid-cols-3 sm:grid-cols-6 lg:grid-cols-8 gap-4 items-end">
    {% for state in literal limit:8 %}
      <li class="animate-rise-in" style="animation-fill-mode: backwards; --index: {{ forloop.index }}">
        <a href="https://literal.club/book/{{ state.book.slug }}" class="block border border-slate-300 dark:border-slate-500 rounded-sm overflow-hidden">
          <img src="{{ state.book.cover }}" alt="{{ state.book.title }}" class="w-full h-auto" eleventy:widths="400">
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<section class="mx-auto max-w-7xl mb-16">
  <header class="flex flex-wrap gap-x-4 gap-y-2 items-baseline justify-between mb-5">
    <h2 class="font-serif text-2xl md:text-4xl font-bold leading-none">What I've been listening to</h2>
    <p class="text-sm md:text-base italic"><a href="https://last.fm/user/nick_cotton" class="underline">last.fm ↗</a></p>
  </header>
  <ul class="list-none p-0 m-0 grid grid-cols-3 sm:grid-cols-6 lg:grid-cols-8 gap-4 items-end">
    {% for album in lastfm limit:8 %}
      <li class="animate-rise-in" style="animation-fill-mode: backwards; --index: {{ forloop.index }}">
        <a href="{{ album.url }}" class="block border border-slate-300 dark:border-slate-500 rounded-sm overflow-hidden">
          <img src="{{ album.image }}" alt="{{ album.title }} by {{ album.artist }}" class="w-full h-auto" eleventy:widths="400">
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
