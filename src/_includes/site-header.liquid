<header>
  <nav class="bg-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 sm:flex h-16 items-center justify-between">
      <a href="/" class="font-serif font-bold text-stone-100 flex items-end gap-1 group home">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-smart-home flip" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M19 8.71l-5.333 -4.148a2.666 2.666 0 0 0 -3.274 0l-5.334 4.148a2.665 2.665 0 0 0 -1.029 2.105v7.2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-7.2c0 -.823 -.38 -1.6 -1.03 -2.105"></path>
          <path d="M16 15c-2.21 1.333 -5.792 1.333 -8 0"></path>
        </svg>
        <span class="flex">
          N<span class="overflow-hidden transition-all opacity-0 w-0 group-hover:opacity-100 group-hover:w-[25px]">ick </span>
          C<span class="overflow-hidden transition-all opacity-0 w-0 group-hover:opacity-100 group-hover:w-[45px]">otton</span></span>
      </a>
      <ul class="flex space-x-4 text-stone-100">
        {% for item in navigation.items %}
          {% assign current = '' %}
          {% assign letters = item.text | split: '' %}
          {% if item.url == page.url %}
            {% assign current = 'aria-current="page"' %}
            {% assign highlight = 'cursor-default' %}
          {% endif %}
          <li>
            <a
              href="{{ item.url }}"
              class="text-base font-bold flex {{ highlight }}"
              {{ current }}
            >
              {% for letter in letters %}
                <span class="nav-letter">{{ letter }}</span>
              {% endfor %}
            </a>
          </li>
        {% endfor %}
      </ul>

    </div>
  </nav>
</header>
