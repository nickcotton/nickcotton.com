{% assign propertyTitle = site.data.meta.title | default: '' %}
{% if propertyTitle == '' %}
  {% if site.data.name == page.title %}
    {% assign propertyTitle = page.title %}
  {% else %}
    {% assign propertyTitle = page.title | append: ' :: ' | append: site.data.name %}
  {% endif %}
{% endif %}
{% assign propertyUrl = site.data.url | append: page.url %}

<meta property="og:site_name" content="{{ site.data.name }}" />
<meta property="og:title" content="{{ propertyTitle }}" />
<meta property="og:type" content="website" />
<meta property="og:url" content="{{ propertyUrl }}" />
