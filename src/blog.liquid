---
layout: 'layouts/page.liquid'
title: 'blog'
meta:
  desc:
    'The blog part.'
---

{% for post in collections.posts reversed %}
  <div class="flex flex-col sm:flex-row gap-x-6 gap-y-2 items-baseline justify-between border-b border-slate-400 dark:border-slate-700 py-4 last:border-b-0">
    <h2 class="dark:text-white text-xl sm:text-2xl leading-none"><a href="{{ post.url }}" class="block">{{ post.data.title }}</a></h2>
    <p class="shrink-0 text-slate-400 sm:text-slate-500 dark:text-slate-300 leading-none text-sm sm:text-base">{{ post.page.date | postDate }}</p>
  </div>
{% endfor %}
