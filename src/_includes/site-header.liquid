<header>
  <nav class="dark:bg-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex h-16 items-center gap-4" x-data="{open: false, toggle(){this.open = !this.open;}}">
      <a href="/" class="font-serif font-bold flex items-center gap-2 group relative z-20 mr-auto">
        <svg width="16" height="16" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="200" height="200" rx="40" fill="url(#paint0_linear_16_88)"/>
          <path d="M156.816 37C158.669 37 160.079 38.6633 159.775 40.4913L139.763 161.037C139.523 162.484 138.271 163.545 136.804 163.545H126.327C125.214 163.545 124.192 162.929 123.673 161.945L72.3591 64.6421C72.2116 64.3625 71.9215 64.1875 71.6054 64.1875V64.1875C71.1888 64.1875 70.8333 64.4886 70.7649 64.8995L54.7417 161.039C54.5006 162.485 53.249 163.545 51.7825 163.545H42.5391C40.6861 163.545 39.2761 161.882 39.5796 160.054L59.592 39.5087C59.8323 38.0613 61.0843 37 62.5515 37H73.0304C74.1424 37 75.1631 37.6151 75.6828 38.5982L127.243 136.151C127.391 136.43 127.681 136.605 127.996 136.605V136.605C128.413 136.605 128.769 136.304 128.837 135.893L144.861 39.508C145.102 38.0609 146.354 37 147.821 37H156.816Z" fill="black"/>
          <defs>
          <linearGradient id="paint0_linear_16_88" x1="47.7413" y1="2.75768e-06" x2="152.259" y2="200" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FFDF6D"/>
          <stop offset="1" stop-color="#FFC700"/>
          </linearGradient>
          </defs>
        </svg>

        <span class="flex">
          N<span class="overflow-hidden transition-all opacity-0 w-0 group-hover:opacity-100 group-hover:w-[25px]">ick </span>
          C<span class="overflow-hidden transition-all opacity-0 w-0 group-hover:opacity-100 group-hover:w-[45px]">otton</span></span>
      </a>
      <nav class="fixed md:static flex justify-center md:contents inset-1 bg-white shadow-md rounded-md pt-20 z-10" x-cloak :class="open || 'hidden'">
        <ul class="flex flex-col md:flex-row md:items-center gap-y-8 gap-x-4 text-gray-900 dark:md:text-stone-100">
          {% for item in navigation.items %}
            {% assign current = '' %}
            {% assign letters = item.text | split: '' %}
            {% if item.url == page.url %}
              {% assign current = 'aria-current="page"' %}
              {% assign highlight = 'cursor-default' %}
            {% endif %}
            <li>
              <a
                href="{{ item.url }}"
                class="text-7xl md:text-base flex justify-center {{ highlight }}"
                {{ current }}
              >
                {% for letter in letters %}
                  <span class="nav-letter">{{ letter }}</span>
                {% endfor %}
              </a>
            </li>
          {% endfor %}
          <li class="flex justify-center">
            <a href="/feed.xml" aria-label="RSS feed">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
                <path d="M3.75 3a.75.75 0 0 0-.75.75v.5c0 .414.336.75.75.75H4c6.075 0 11 4.925 11 11v.25c0 .414.336.75.75.75h.5a.75.75 0 0 0 .75-.75V16C17 8.82 11.18 3 4 3h-.25Z" />
                <path d="M3 8.75A.75.75 0 0 1 3.75 8H4a8 8 0 0 1 8 8v.25a.75.75 0 0 1-.75.75h-.5a.75.75 0 0 1-.75-.75V16a6 6 0 0 0-6-6h-.25A.75.75 0 0 1 3 9.25v-.5ZM7 15a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z" />
              </svg>
            </a>
          </li>
        </ul>
        <button class="text-gray-900 absolute top-4 right-3" :class="open || 'hidden'" @click="toggle">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
            <path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
          </svg>
        </button>
      </nav>
      <button class="flex h-5 w-5 items-center justify-center ml-auto md:ml-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 hidden dark:block animate-pop" onclick="document.documentElement.classList.remove('dark'); localStorage.theme = 'light'">
          <path d="M10 2a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 2ZM10 15a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 10 15ZM10 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM15.657 5.404a.75.75 0 1 0-1.06-1.06l-1.061 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM6.464 14.596a.75.75 0 1 0-1.06-1.06l-1.06 1.06a.75.75 0 0 0 1.06 1.06l1.06-1.06ZM18 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 18 10ZM5 10a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 5 10ZM14.596 15.657a.75.75 0 0 0 1.06-1.06l-1.06-1.061a.75.75 0 1 0-1.06 1.06l1.06 1.06ZM5.404 6.464a.75.75 0 0 0 1.06-1.06l-1.06-1.06a.75.75 0 1 0-1.061 1.06l1.06 1.06Z" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 dark:hidden animate-pop" onclick="document.documentElement.classList.add('dark'); localStorage.theme = 'dark'">
          <path fill-rule="evenodd" d="M7.455 2.004a.75.75 0 0 1 .26.77 7 7 0 0 0 9.958 7.967.75.75 0 0 1 1.067.853A8.5 8.5 0 1 1 6.647 1.921a.75.75 0 0 1 .808.083Z" clip-rule="evenodd" />
        </svg>
      </button>
      <button class="md:hidden dark:text-stone-100" @click="toggle">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
          <path fill-rule="evenodd" d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm8.25 5.25a.75.75 0 0 1 .75-.75h8.25a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </nav>
</header>
