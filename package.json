{
  "engines": {
    "node": "20.9.0",
    "npm": "10.1.0"
  },
  "author": {
    "name": "Nick Cotton",
    "email": "nick.c.cotton@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "lint-staged": {
    "*.html": "prettier --write",
    "*.css": "stylelint --cache --fix",
    "*.js": "eslint --cache --fix"
  },
  "type": "module",
  "scripts": {
    "clean": "rimraf _site",
    "prepare": "husky",
    "preview": "npx vite preview",
    "predev": "run-s clean",
    "dev": "cross-env NODE_ENV=development run-p dev:*",
    "dev:eleventy": "npx @11ty/eleventy --serve --incremental --port=8081",
    "prebuild": "run-s clean",
    "build": "cross-env NODE_ENV=production run-s build:*",
    "build:eleventy": "npx @11ty/eleventy",
    "lint": "run-s lint:*",
    "lint:html": "npx prettier --check \"src/**/*.liquid\"",
    "lint:stylelint": "npx stylelint \"src/**/*.css\"",
    "lint:eslint": "npx eslint --ext .js src/",
    "format": "run-s format:*",
    "format:html": "npx prettier --write \"src/**/*.liquid\"",
    "format:stylelint": "npx stylelint \"src/**/*.css\" --fix",
    "format:eslint": "npx eslint --ext .js src/ --fix",
    "validate": "run-s build lint",
    "setup": "npm install && npm run validate"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.0.0-alpha.12",
    "@11ty/eleventy-img": "^4.0.2",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@11ty/eleventy-plugin-vite": "^4.0.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@playwright/test": "^1.44.1",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20.12.12",
    "autoprefixer": "^10.4.19",
    "browserslist": "^4.23.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-compat": "^4.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "lodash.escape": "^4.0.1",
    "luxon": "^3.4.4",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "nanoid": "^5.0.7",
    "netlify-plugin-cache": "^1.0.3",
    "node-fetch": "^3.3.2",
    "npm-run-all": "^4.1.5",
    "outdent": "^0.8.0",
    "postcss": "^8.4.38",
    "postcss-cli": "^10.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "rimraf": "^5.0.7",
    "rss-parser": "^3.13.0",
    "shiki": "^1.6.0",
    "stylelint": "^16.6.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^3.4.3"
  },
  "dependencies": {
    "@alpinejs/persist": "^3.14.0",
    "alpinejs": "^3.14.0"
  }
}
